<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="cron_config_example" type="text" translate="label" sortOrder="3" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Cron Config Example</label>
            <tab>training</tab>
            <resource>Training_CronConfigPath::config</resource>

            <group id="cron" type="text" translate="label" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Cron Settings</label>

                <field id="cron_expr" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cron Expression</label>
                    <source_model>Magento\Cron\Model\Config\Source\Frequency</source_model>
                </field>

                <field id="cron_expr_text" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cron Expression With Text</label>
                </field>
            </group>
        </section>
    </system>
</config>
